# Copie para `.env` e ajuste. O `.env` não vai para o repositório.
#
#   cp .env.example .env
#
# O padrão de tudo aqui é o valor de PRODUÇÃO. Para desenvolver na sua
# máquina, basta a primeira linha.

# ---------------------------------------------------------------------------
# Desenvolvimento
# ---------------------------------------------------------------------------
# 1 liga o modo de depuração. NUNCA use 1 no servidor: a página de erro do
# Django mostra o traceback, as variáveis de ambiente e a SECRET_KEY.
SOAR_DEBUG=1

# ---------------------------------------------------------------------------
# Servidor (obrigatórias quando SOAR_DEBUG=0)
# ---------------------------------------------------------------------------
# Gere a chave com:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Precisa de pelo menos 50 caracteres — o settings.py recusa chave fraca.
#SOAR_SECRET_KEY=

# Domínios do site, separados por vírgula.
#SOAR_ALLOWED_HOSTS=soar.com.br,www.soar.com.br

# 1 quando um Nginx/balanceador termina o HTTPS na frente da aplicação.
#SOAR_ATRAS_DE_PROXY=0

# HSTS: comece em 3600 (1 hora). Só suba para 31536000 depois de confirmar
# que o HTTPS está firme — o navegador guarda o valor e não dá para cancelar.
#SOAR_HSTS_SECONDS=3600
# Preload só depois do HSTS estar em um ano: sair da lista demora meses.
#SOAR_HSTS_PRELOAD=0

# ---------------------------------------------------------------------------
# Content-Security-Policy
# ---------------------------------------------------------------------------
# 1 (padrão) só relata as violações no console do navegador, sem bloquear.
# Rode assim alguns dias, veja o que aparece, e então mude para 0.
#SOAR_CSP_SOMENTE_RELATORIO=1

# ---------------------------------------------------------------------------
# Banco — SQLite trava com escrita concorrente; use Postgres no servidor
# ---------------------------------------------------------------------------
#SOAR_DB_ENGINE=postgresql
#SOAR_DB_NAME=soar
#SOAR_DB_USER=soar
#SOAR_DB_PASSWORD=
#SOAR_DB_HOST=localhost
#SOAR_DB_PORT=5432

# ---------------------------------------------------------------------------
# Cache — sustenta os limites de tentativa de login
# ---------------------------------------------------------------------------
# Sem Redis, a contagem é por processo do servidor: com vários workers o
# limite fica mais frouxo do que o configurado.
#SOAR_REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# E-mail — confirmação de cadastro e recuperação de senha
# ---------------------------------------------------------------------------
# Sem configurar, as mensagens saem no terminal (dá para desenvolver assim).
#SOAR_EMAIL_BACKEND=smtp
#SOAR_EMAIL_HOST=smtp.exemplo.com.br
#SOAR_EMAIL_PORT=587
#SOAR_EMAIL_USER=
#SOAR_EMAIL_PASSWORD=
#SOAR_EMAIL_TLS=1
#SOAR_EMAIL_REMETENTE=Soar Operadora <nao-responda@soaroperadora.com.br>

# ---------------------------------------------------------------------------
# Limites de tentativa
# ---------------------------------------------------------------------------
#SOAR_LIMITE_LOGIN=5
#SOAR_LIMITE_LOGIN_JANELA=900
#SOAR_LIMITE_CADASTRO=5
#SOAR_LIMITE_AVALIACAO=5
#SOAR_LIMITE_RESERVA=10

# Duração da sessão em segundos (padrão: 7 dias).
#SOAR_SESSAO_SEGUNDOS=604800
